# Cloud deployment; tools/lan without this variable remains local
WEEDING_MODE=online
WEEDING_PORT=8788
WEEDING_DISABLE_WS=0
WEEDING_MAX_ROOMS=5
WEEDING_MAX_PLAYERS=20
WEEDING_MAX_RSS_MB=512
# CPU percentage relative to one logical core
WEEDING_MAX_CPU_PERCENT=85
WEEDING_MAX_LAG_MS=100

# Admin disabled until a secret of at least 32 characters is configured
WEEDING_ADMIN_TOKEN=
# Set to 1 only for a trusted reverse proxy on this machine
WEEDING_TRUST_PROXY=0
